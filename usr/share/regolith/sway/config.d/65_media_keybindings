### Bindings managed by gsd_media_keys

# Volume Controls
# regolith-sway-volumectl runs volumectl with -n where avizo has it: the OSD
# then names the device (e.g. "Headphones - Built-in Audio Analog Stereo")
# unless it is a built-in speaker, as gnome-settings-daemon does in the X11
# session. With an older avizo it runs plain volumectl, without the name.
set_from_resource $wm.media.volume.step sway.media.volume.step 5
bindsym --locked XF86AudioRaiseVolume exec regolith-sway-volumectl -u + $wm.media.volume.step
bindsym --locked XF86AudioLowerVolume exec regolith-sway-volumectl -u - $wm.media.volume.step
bindsym --locked XF86AudioMute exec regolith-sway-volumectl %
bindsym --locked XF86AudioMicMute exec regolith-sway-volumectl -m %
# The variants gnome-settings-daemon handles in the X11 session: Shift (with or
# without Ctrl) changes the volume in fine 2 % steps; Ctrl, and Alt ("quiet",
# without the feedback sound, which avizo never plays) act as the plain keys.
bindsym --locked Shift+XF86AudioRaiseVolume exec regolith-sway-volumectl -u + 2
bindsym --locked Shift+XF86AudioLowerVolume exec regolith-sway-volumectl -u - 2
bindsym --locked Ctrl+Shift+XF86AudioRaiseVolume exec regolith-sway-volumectl -u + 2
bindsym --locked Ctrl+Shift+XF86AudioLowerVolume exec regolith-sway-volumectl -u - 2
bindsym --locked Ctrl+XF86AudioRaiseVolume exec regolith-sway-volumectl -u + $wm.media.volume.step
bindsym --locked Ctrl+XF86AudioLowerVolume exec regolith-sway-volumectl -u - $wm.media.volume.step
bindsym --locked Alt+XF86AudioRaiseVolume exec regolith-sway-volumectl -u + $wm.media.volume.step
bindsym --locked Alt+XF86AudioLowerVolume exec regolith-sway-volumectl -u - $wm.media.volume.step
bindsym --locked Ctrl+Alt+XF86AudioRaiseVolume exec regolith-sway-volumectl -u + $wm.media.volume.step
bindsym --locked Ctrl+Alt+XF86AudioLowerVolume exec regolith-sway-volumectl -u - $wm.media.volume.step
bindsym --locked Alt+XF86AudioMute exec regolith-sway-volumectl %

# Brightness Controls: regolith-brightness steps the built-in panel and every
# external screen (over DDC/CI) and shows the level with avizo. Screens whose
# model name or serial number is in wm.media.brightness.ddc.exclude
# (comma-separated) are left alone. The service started here
# (regolith-brightnessd) drives the displays; the keys hand it their presses.
set_from_resource $wm.media.brightness.step wm.media.brightness.step 5
set_from_resource $wm.media.brightness.ddc.exclude wm.media.brightness.ddc.exclude ""
exec regolith-brightnessd --step $wm.media.brightness.step --exclude "$wm.media.brightness.ddc.exclude"
bindsym --locked XF86MonBrightnessUp exec regolith-brightness up
bindsym --locked XF86MonBrightnessDown exec regolith-brightness down

# Eject, battery and airplane mode keys, handled by gnome-settings-daemon in
# the X11 session: eject a removable drive (on the lock screen too), show the
# battery level, and turn airplane mode or Bluetooth airplane mode on or off
bindsym --locked XF86Eject exec regolith-sway-gsd-keys eject
bindsym XF86Battery exec regolith-sway-gsd-keys battery
bindsym XF86WLAN exec regolith-sway-gsd-keys rfkill
bindsym XF86UWB exec regolith-sway-gsd-keys rfkill
bindsym XF86RFKill exec regolith-sway-gsd-keys rfkill
bindsym XF86Bluetooth exec regolith-sway-gsd-keys bluetooth

# Player Controls
# The keycodes 172 and 208 are both bound to XF86AudioPlay but have different meanings
bindcode --locked 172 exec playerctl play-pause
bindcode --locked 208 exec playerctl play
bindsym --locked XF86AudioPause exec playerctl pause   
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioStop exec playerctl stop
# With Ctrl, as in the X11 session, the same as without
bindcode --locked Ctrl+172 exec playerctl play-pause
bindcode --locked Ctrl+208 exec playerctl play
bindsym --locked Ctrl+XF86AudioNext exec playerctl next
bindsym --locked Ctrl+XF86AudioPrev exec playerctl previous
# The other player keys gnome-settings-daemon handles in the X11 session:
# Rewind and Forward seek 10 s back and 45 s ahead, Repeat switches between
# repeating the playlist and not repeating, and Shuffle toggles shuffle. The
# Media key opens the default audio player.
bindsym --locked XF86AudioRewind exec playerctl position 10-
bindsym --locked XF86AudioForward exec playerctl position 45+
bindsym --locked XF86AudioRepeat exec [ "$(playerctl loop)" = Playlist ] && playerctl loop None || playerctl loop Playlist
bindsym --locked XF86AudioRandomPlay exec playerctl shuffle Toggle
bindsym XF86AudioMedia exec gtk-launch $(xdg-mime query default audio/x-vorbis+ogg)

# Start avizo for overlays
exec avizo-service

# Start Playerctl service
exec playerctld daemon

# Launcher and lock keys, handled by gnome-settings-daemon in the X11 session:
# the calculator, the default web browser and mail client, the home folder,
# GNOME Settings and the lock screen (the session's idle manager locks on
# loginctl's request). The Search key does nothing there (it opens the GNOME
# Shell search), so it isn't bound here either. Like gnome-settings-daemon,
# the Calculator key also tries the desktop id of the gnome-calculator snap.
bindsym XF86Calculator exec gtk-launch org.gnome.Calculator || gtk-launch gnome-calculator_gnome-calculator
bindsym XF86WWW exec gtk-launch $(xdg-settings get default-web-browser)
bindsym XF86Mail exec gtk-launch $(xdg-settings get default-url-scheme-handler mailto)
bindsym XF86Explorer exec xdg-open ~
bindsym XF86Tools exec gtk-launch org.gnome.Settings
# The lock key (keycode 160, XF86ScreenSaver) is bound by its code: sway looks
# key names up without regard to case and takes "XF86ScreenSaver" for
# XF86Screensaver, another key
bindcode 160 exec loginctl lock-session
