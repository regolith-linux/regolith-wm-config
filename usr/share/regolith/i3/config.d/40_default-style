# Provide window class to float above tiled windows
floating_maximum_size -1 x -1
for_window [class="floating_window"] floating enable

# Set titlebar mode
set_from_resource $wm.floatingwindow.border.style wm.floatingwindow.border.style pixel
set_from_resource $wm.floatingwindow.border.size wm.floatingwindow.border.size 1
set_from_resource $wm.window.border.style wm.window.border.style pixel
set_from_resource $wm.window.border.size wm.window.border.size 1
# i3 takes no size with the none style, so each style has its own
# default_border and default_floating_border line.
include /usr/share/regolith/i3/default-border/$wm.window.border.style
include /usr/share/regolith/i3/default-floating-border/$wm.floatingwindow.border.style

# Apply the configured borders to every new window, including windows that ask
# to draw their own decorations: tiled windows get wm.window.border.*,
# floating windows wm.floatingwindow.border.*. Without a size, border uses the
# size of the matching default_border or default_floating_border line.
for_window [tiling] border $wm.window.border.style
for_window [floating] border $wm.floatingwindow.border.style

# Enable popup during fullscreen
set_from_resource $wm.gaps.popup_during_fullscreen wm.gaps.popup_during_fullscreen smart
popup_during_fullscreen $wm.gaps.popup_during_fullscreen

# window focus follows your mouse movements as the mouse crosses window borders
set_from_resource $wm.gaps.focus_follows_mouse wm.gaps.focus_follows_mouse no
focus_follows_mouse $wm.gaps.focus_follows_mouse

# Hiding borders adjacent to the screen edges.
# The "smart" setting hides borders on workspaces with only one window visible.
set_from_resource $wm.hide.edge.borders wm.hide.edge.borders smart
hide_edge_borders $wm.hide.edge.borders
