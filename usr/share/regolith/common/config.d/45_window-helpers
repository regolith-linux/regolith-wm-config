###############################################################################
# Window Helpers
###############################################################################
#
# Keys that focus an application's window or start it, pop the focused
# window out as a centred sticky floating window and back, and switch its
# transparency. They work the same way in the i3 and the sway session.

## Launch // Focus or launch browser // <><Ctrl><Shift> Return ##
set_from_resource $wm.binding.focus_or_launch.browser wm.binding.focus_or_launch.browser Ctrl+Shift+Return
set_from_resource $wm.focus_or_launch.browser wm.focus_or_launch.browser ""
bindsym $mod+$wm.binding.focus_or_launch.browser exec --no-startup-id /usr/bin/regolith-window-helper focus-or-launch --browser "$wm.focus_or_launch.browser"

## Launch // Focus or launch file manager // <><Ctrl><Shift> n ##
set_from_resource $wm.binding.focus_or_launch.files wm.binding.focus_or_launch.files Ctrl+Shift+n
set_from_resource $wm.focus_or_launch.files wm.focus_or_launch.files org.gnome.Nautilus
bindsym $mod+$wm.binding.focus_or_launch.files exec --no-startup-id /usr/bin/regolith-window-helper focus-or-launch "$wm.focus_or_launch.files"

## Modify // Pop window out // <> o ##
set_from_resource $wm.binding.pop_out wm.binding.pop_out o
set_from_resource $wm.pop_out.width wm.pop_out.width 60
set_from_resource $wm.pop_out.height wm.pop_out.height 70
bindsym $mod+$wm.binding.pop_out exec --no-startup-id /usr/bin/regolith-window-helper pop-out --width "$wm.pop_out.width" --height "$wm.pop_out.height"

## Modify // Switch window transparency // <><Shift> o ##
set_from_resource $wm.binding.transparency wm.binding.transparency Shift+o
set_from_resource $wm.transparency.opacity wm.transparency.opacity 0.85
bindsym $mod+$wm.binding.transparency exec --no-startup-id /usr/bin/regolith-window-helper transparency --opacity "$wm.transparency.opacity"

# Records the focus and opening order of windows for the focus-or-launch
# keys, across reloads and i3 restarts. One instance runs per session.
exec_always --no-startup-id /usr/bin/regolith-window-helper track
