#!/usr/bin/python3
"""Copy what is shown on the screen to the clipboard (80_copy_from_screen).

    regolith-copy-from-screen text [LANGUAGES]  text recognised in an area
    regolith-copy-from-screen qr                content of the QR code in an area
    regolith-copy-from-screen color             colour of a point, as #rrggbb

The user drags out the area, or clicks the point, with slurp in the sway
session and with slop in the X11 session. The area is captured at the output's
own pixels, with grim in sway and ImageMagick's import in X11, and the result
goes on the clipboard with wl-copy or xclip. A notification reports what was
copied, or why nothing was. A cancelled selection does nothing.

Text is recognised by tesseract in LANGUAGES, written the way tesseract writes
language lists (eng, deu, deu+eng); the default is eng. QR codes are read by
zbarimg, and other kinds of barcode are disregarded.

A QR code often holds a secret, such as the seed of a second factor or a
wireless password, so its content only ever travels through pipes: it is never
written to a file, put on a command line, shown in a notification or logged.
"""
import html
import os
import re
import shutil
import subprocess
import sys
import time

APP_NAME = "Copy from Screen"
# Notifications show the first copied line, cut short after this many
# characters.
PREVIEW_LENGTH = 80
WAYLAND = bool(os.environ.get("WAYLAND_DISPLAY"))
TEXT_TYPE = "text/plain;charset=utf-8"
BINARY_TYPE = "application/octet-stream"
# A header field of a PPM image, after any whitespace and comments.
PPM_FIELD = re.compile(rb"(?:\s|#[^\n]*\n)*(\S+)")


def run(argv, data=None, env=None, timeout=30):
    """Run argv, with data on its standard input. Return the exit status and
    the standard output; the exit status is None if it could not be run. The
    standard error is dropped, so that nothing a decoder prints reaches the
    window manager's log."""
    try:
        proc = subprocess.run(
            argv, input=data if data is not None else b"",
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            env=env, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None, b""
    return proc.returncode, proc.stdout


def notify(summary, body="", urgency="normal"):
    # Notification bodies may be read as markup: show the text as it is.
    run(["notify-send", "--app-name", APP_NAME, "--urgency", urgency,
         summary, html.escape(body, quote=False)], timeout=10)


def missing(program, summary):
    """Report a program that the session can't find."""
    notify(summary, "%s was not found. Install it to use this key." % program,
           "critical")


def select(point):
    """Let the user drag out an area, or click a point. Return the area as
    (x, y, width, height) in the session's coordinates (logical coordinates
    in sway), or None if the selection was cancelled."""
    if WAYLAND:
        argv = ["slurp", "-f", "%x %y %w %h"] + (["-p"] if point else [])
    else:
        # Without window selection, a click picks a point, not a window.
        argv = ["slop", "-f", "%x %y %w %h"] + (["-t", "0"] if point else [])
    if shutil.which(argv[0]) is None:
        missing(argv[0], "Nothing copied")
        return None
    # The user may take as long as they like.
    status, out = run(argv, timeout=None)
    if status != 0:
        return None
    match = re.fullmatch(r"\s*(-?\d+) (-?\d+) (\d+) (\d+)\s*",
                         out.decode("ascii", "replace"))
    if match is None:
        return None
    x, y, width, height = (int(value) for value in match.groups())
    if point:
        return x, y, 1, 1
    if width < 1 or height < 1:
        return None
    return x, y, width, height


def parse_ppm(data):
    """Return (width, height, RGB bytes) from a binary PPM image, or None."""
    fields = []
    pos = 0
    while len(fields) < 4:
        match = PPM_FIELD.match(data, pos)
        if match is None:
            return None
        fields.append(match.group(1))
        pos = match.end()
    if fields[0] != b"P6" or not all(f.isdigit() for f in fields[1:]):
        return None
    width, height, maxval = (int(f) for f in fields[1:])
    pixels = data[pos + 1:]
    size = 2 if maxval > 255 else 1
    if width < 1 or height < 1 or not 0 < maxval < 65536 or \
            len(pixels) < width * height * 3 * size:
        return None
    if size == 1 and maxval == 255:
        return width, height, pixels[:width * height * 3]
    rgb = bytearray()
    for i in range(0, width * height * 3 * size, size):
        value = int.from_bytes(pixels[i:i + size], "big")
        rgb.append((value * 255 + maxval // 2) // maxval)
    return width, height, bytes(rgb)


def capture(area):
    """Capture an area at the output's own pixels: an area on an output at
    scale 2 comes out twice as large as its logical size. Return the image as
    a binary PPM, or None."""
    x, y, width, height = area
    if WAYLAND:
        argv = ["grim", "-t", "ppm", "-g",
                "%d,%d %dx%d" % (x, y, width, height), "-"]
    else:
        # -depth 8: ImageMagick would otherwise write 16 bits per channel.
        argv = ["import", "-silent", "-window", "root",
                "-crop", "%dx%d+%d+%d" % (width, height, x, y), "+repage",
                "-depth", "8", "ppm:-"]
    if shutil.which(argv[0]) is None:
        missing(argv[0], "Nothing copied")
        return None
    # A capture can fail for a moment, for example while the outputs change:
    # try again a few times, within about two seconds.
    for delay in (0, 0.2, 0.4, 0.6, 0.8):
        time.sleep(delay)
        status, image = run(argv)
        if status == 0 and parse_ppm(image) is not None:
            return image
    notify("Nothing copied", "The screen could not be captured.", "critical")
    return None


def copy(data, mime_type):
    """Put data on the clipboard. wl-copy and xclip keep serving it after this
    returns, until something else is copied."""
    if WAYLAND:
        argv = ["wl-copy", "--type", mime_type]
    elif mime_type == TEXT_TYPE:
        argv = ["xclip", "-selection", "clipboard", "-t", "UTF8_STRING"]
    else:
        argv = ["xclip", "-selection", "clipboard", "-t", mime_type]
    if shutil.which(argv[0]) is None:
        missing(argv[0], "Nothing copied")
        return False
    try:
        # Both fork a process that serves the clipboard: it must not hold a
        # pipe this waits on.
        proc = subprocess.run(argv, input=data, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.SubprocessError):
        proc = None
    if proc is None or proc.returncode != 0:
        notify("Nothing copied", "The clipboard could not be set.",
               "critical")
        return False
    return True


def installed_languages():
    _status, out = run(["tesseract", "--list-langs"])
    # The first line names the data directory; one language per line follows.
    return {line.strip() for line in
            out.decode("utf-8", "replace").splitlines()[1:]}


def copy_text(languages):
    if shutil.which("tesseract") is None:
        missing("tesseract", "Text not copied")
        return
    codes = languages.split("+")
    if not all(re.fullmatch(r"[\w./-]+", code) for code in codes):
        notify("Text not copied",
               "wm.ocr.languages is not a tesseract language list: %s"
               % languages, "critical")
        return
    absent = [code for code in codes if code not in installed_languages()]
    if absent:
        notify("Text not copied",
               "Text recognition language not installed: %s (package %s)"
               % (", ".join(absent),
                  ", ".join("tesseract-ocr-" + code.lower().replace("_", "-")
                            for code in absent)),
               "critical")
        return
    area = select(point=False)
    if area is None:
        return
    image = capture(area)
    if image is None:
        return
    # One thread: tesseract's thread pool only slows down small images.
    env = dict(os.environ, OMP_THREAD_LIMIT="1")
    # --psm 6: the area is one block of text, read from top to bottom.
    status, out = run(["tesseract", "stdin", "stdout", "-l", languages,
                       "--psm", "6"], data=image, env=env)
    if status != 0:
        notify("Text not copied", "Text recognition failed.", "critical")
        return
    lines = [line.strip() for line in
             out.decode("utf-8", "replace").splitlines()]
    lines = [line for line in lines if line]
    if not lines:
        notify("No text found", "The selected area holds no text.")
        return
    if not copy("\n".join(lines).encode("utf-8"), TEXT_TYPE):
        return
    preview = lines[0]
    if len(preview) > PREVIEW_LENGTH:
        preview = preview[:PREVIEW_LENGTH] + "…"
    notify("Text copied", preview)


def count_qr_codes(image, qr_only):
    """Count the QR codes in the image. With -Sbinary, zbarimg's XML lists no
    symbols, so they are counted in a pass without it."""
    status, out = run(["zbarimg", "--nodbus", "--quiet", "--xml"]
                      + qr_only + ["-"], data=image)
    if status not in (0, 4):  # 4: no code found
        return None
    # Symbol data is in CDATA sections (or base64): only real elements count.
    out = re.sub(rb"<!\[CDATA\[.*?\]\]>", b"", out, flags=re.DOTALL)
    return len(re.findall(rb"<symbol[\s>]", out))


def copy_qr():
    if shutil.which("zbarimg") is None:
        missing("zbarimg", "QR code not copied")
        return
    area = select(point=False)
    if area is None:
        return
    image = capture(area)
    if image is None:
        return
    qr_only = ["-Sdisable", "-Sqrcode.enable"]
    count = count_qr_codes(image, qr_only)
    if count is None:
        notify("QR code not copied", "zbarimg could not read the area.",
               "critical")
        return
    if count == 0:
        notify("No QR code found", "The selected area holds no QR code.")
        return
    if count > 1:
        notify("Several QR codes found",
               "Select an area that holds only one of them.")
        return
    # -Sbinary: the content exactly as encoded, without converting it to
    # UTF-8; --raw adds nothing after it.
    status, content = run(["zbarimg", "--nodbus", "--quiet", "--raw",
                           "-Sbinary"] + qr_only + ["-"], data=image)
    if status != 0 or not content:
        notify("QR code not copied", "The QR code could not be read.",
               "critical")
        return
    try:
        content.decode("utf-8")
        mime_type = TEXT_TYPE
    except UnicodeDecodeError:
        mime_type = BINARY_TYPE
    if not copy(content, mime_type):
        return
    # The content itself is never shown.
    notify("QR code copied", "Its content is on the clipboard.")


def copy_color():
    area = select(point=True)
    if area is None:
        return
    image = capture(area)
    if image is None:
        return
    width, height, rgb = parse_ppm(image)
    # On an output at scale 2 the point covers 2x2 pixels: take the middle.
    offset = ((height // 2) * width + width // 2) * 3
    value = "#%02x%02x%02x" % tuple(rgb[offset:offset + 3])
    if not copy(value.encode("ascii"), TEXT_TYPE):
        return
    notify("Colour copied", value)


def main(argv):
    action = argv[1] if len(argv) > 1 else ""
    if action == "text":
        copy_text(argv[2] if len(argv) > 2 and argv[2] else "eng")
    elif action == "qr":
        copy_qr()
    elif action in ("color", "colour"):
        copy_color()
    else:
        sys.stderr.write(
            "usage: regolith-copy-from-screen text [LANGUAGES] | qr | color\n")
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
