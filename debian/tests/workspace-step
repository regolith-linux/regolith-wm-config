#!/usr/bin/python3
#
# Runs i3 on Xvfb with the installed 30_navigation partial, which starts
# regolith-workspace-step, and presses the next and previous workspace keys
# through XTEST. Checks that by default they wrap around; that with
# wm.workspace.wrap set to no they stop at the first and the last workspace,
# also for presses made back to back and after `i3-msg restart`; that the
# value is read on every press; and that the helper exits with i3.

import os
import subprocess
import sys
import tempfile
import time

import i3ipc
from Xlib import XK, X, Xatom
from Xlib import display as xdisplay
from Xlib.ext import xtest

NAVIGATION = "/usr/share/regolith/common/config.d/30_navigation"
HELPER = "regolith-workspace-step"
TIMEOUT = 10.0
# How long a press that must do nothing is given to do something anyway.
SETTLE = 1.0

# The variables the root config sets for 30_navigation, with its defaults.
I3_CONFIG = """\
font pango:monospace 8
ipc-socket {socket}
workspace_auto_back_and_forth yes
set $mod Mod4
set $alt Mod1
set $wm.binding.left h
set $wm.binding.right l
set $wm.binding.up k
set $wm.binding.down j
set $ws_high_key Ctrl
{workspaces}
include {navigation}
"""

NEXT_KEYS = ("Super_L+Tab", "Super_L+Alt_L+Right", "Super_L+Control_L+Tab",
             "Super_L+Control_L+l")
PREV_KEYS = ("Super_L+Shift_L+Tab", "Super_L+Alt_L+Left",
             "Super_L+Control_L+Shift_L+Tab", "Super_L+Control_L+h")

failures = []


def check(description, ok):
    print(("PASS: " if ok else "FAIL: ") + description, flush=True)
    if not ok:
        failures.append(description)


def wait_for(what, test, timeout=TIMEOUT):
    deadline = time.monotonic() + timeout
    while True:
        value = test()
        if value:
            return value
        if time.monotonic() > deadline:
            sys.exit(f"FAIL: timed out waiting for {what}")
        time.sleep(0.1)


def helpers():
    """The pids of running `regolith-workspace-step --serve` processes."""
    pids = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().split(b"\0")
        except OSError:
            continue
        if b"--serve" in argv and any(
                os.path.basename(a) == HELPER.encode() for a in argv):
            pids.append(int(pid))
    return pids


class Session:
    def __init__(self, dpy, socket):
        self.dpy = dpy
        self.socket = socket
        self.i3 = None

    def connect(self):
        def attempt():
            try:
                return i3ipc.Connection(self.socket)
            except Exception:
                return None
        self.i3 = wait_for("i3", attempt)

    def focused(self):
        return next(w.name for w in self.i3.get_workspaces() if w.focused)

    def names(self):
        return sorted(w.name for w in self.i3.get_workspaces())

    def go(self, name):
        self.i3.command(f"workspace --no-auto-back-and-forth {name}")
        wait_for(f"workspace {name}", lambda: self.focused() == name)

    def set_wrap(self, value):
        """Set (or with None, remove) wm.workspace.wrap, as xrdb would."""
        root = self.dpy.screen().root
        atom = self.dpy.intern_atom("RESOURCE_MANAGER")
        if value is None:
            root.delete_property(atom)
        else:
            root.change_property(atom, Xatom.STRING, 8,
                                 f"wm.workspace.wrap:\t{value}\n".encode())
        self.dpy.sync()

    def press(self, keys, times=1):
        codes = [self.dpy.keysym_to_keycode(XK.string_to_keysym(k))
                 for k in keys.split("+")]
        for _ in range(times):
            for code in codes:
                xtest.fake_input(self.dpy, X.KeyPress, code)
            for code in reversed(codes):
                xtest.fake_input(self.dpy, X.KeyRelease, code)
        self.dpy.sync()

    def step(self, start, keys, want, times=1):
        """Press keys on workspace start; focus must end on want (and stay
        there)."""
        self.go(start)
        self.press(keys, times)
        deadline = time.monotonic() + TIMEOUT
        while self.focused() != want and time.monotonic() < deadline:
            time.sleep(0.05)
        time.sleep(SETTLE)
        got = self.focused()
        presses = f"{keys} x{times}" if times > 1 else keys
        check(f"{presses} on {start} -> {want} (got {got})", got == want)

    def open_window(self, workspace):
        self.i3.command(f"workspace --no-auto-back-and-forth {workspace}")
        root = self.dpy.screen().root
        window = root.create_window(0, 0, 100, 100, 0,
                                    self.dpy.screen().root_depth)
        window.map()
        self.dpy.sync()
        wait_for(f"a window on workspace {workspace}",
                 lambda: self.i3.get_tree().find_by_window(window.id))


def main():
    tmp = os.environ.get("AUTOPKGTEST_TMP") or tempfile.mkdtemp()
    socket = os.path.join(tmp, "i3.sock")
    workspaces = "\n".join(
        [f"set $ws{n} {n}" for n in range(1, 20)]
        + [f"set $ws{n}_key {n % 10}" for n in range(1, 11)])
    config = os.path.join(tmp, "i3.conf")
    with open(config, "w") as f:
        f.write(I3_CONFIG.format(socket=socket, workspaces=workspaces,
                                 navigation=NAVIGATION))
    os.environ["XDG_RUNTIME_DIR"] = tmp

    read_fd, write_fd = os.pipe()
    xvfb = subprocess.Popen(
        ["Xvfb", "-displayfd", str(write_fd), "-screen", "0", "1024x768x24",
         "-nolisten", "tcp", "-noreset"],
        pass_fds=(write_fd,), stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL)
    os.close(write_fd)
    with os.fdopen(read_fd) as f:
        number = f.readline().strip()
    if not number:
        sys.exit("FAIL: Xvfb did not start")
    os.environ["DISPLAY"] = ":" + number

    procs = [xvfb]
    try:
        dpy = xdisplay.Display()
        i3 = subprocess.Popen(["i3", "-c", config],
                              stdout=subprocess.DEVNULL)
        procs.insert(0, i3)
        session = Session(dpy, socket)
        session.connect()
        wait_for("regolith-workspace-step to start", helpers)
        for n in ("1", "2", "3"):
            session.open_window(n)

        # Without the value, and with any value other than no or false, the
        # keys wrap around as before.
        session.set_wrap(None)
        for keys in NEXT_KEYS:
            session.step("3", keys, "1")
        for keys in PREV_KEYS:
            session.step("1", keys, "3")
        session.set_wrap("yes")
        session.step("3", NEXT_KEYS[0], "1")

        # With no, they stop at the ends and step normally in between. The
        # value is read on every press: no reload.
        session.set_wrap("no")
        for keys in NEXT_KEYS:
            session.step("3", keys, "3")
            session.step("1", keys, "2")
        for keys in PREV_KEYS:
            session.step("1", keys, "1")
            session.step("3", keys, "2")
        session.set_wrap(" False ")
        session.step("3", NEXT_KEYS[0], "3")

        # Presses made back to back each count once, and stop at the end.
        session.set_wrap("no")
        session.step("1", NEXT_KEYS[0], "3", times=5)
        session.step("3", PREV_KEYS[0], "1", times=5)
        session.step("1", NEXT_KEYS[0], "2", times=1)
        check("no workspace was lost or added",
              session.names() == ["1", "2", "3"])

        # Back to wrapping without a reload.
        session.set_wrap("yes")
        session.step("1", PREV_KEYS[0], "3")

        # After a restart, one instance serves the new i3.
        session.set_wrap("no")
        before = helpers()
        session.i3.command("restart")
        time.sleep(1)
        session.connect()
        wait_for("one regolith-workspace-step after the restart",
                 lambda: len(helpers()) == 1 and helpers() != before)
        session.step("3", NEXT_KEYS[0], "3")
        session.step("3", PREV_KEYS[0], "2")
        check("one instance after i3-msg restart", len(helpers()) == 1)

        session.i3.command("exit")
        i3.wait(timeout=TIMEOUT)
        deadline = time.monotonic() + 5
        while helpers() and time.monotonic() < deadline:
            time.sleep(0.1)
        check("regolith-workspace-step exits with i3", not helpers())
    finally:
        for proc in procs:
            if proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    proc.kill()

    if failures:
        sys.exit(f"{len(failures)} check(s) failed")


if __name__ == "__main__":
    main()
